{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ethpandaops/benchmarkoor/schemas/tempo-engine-suite-v1.schema.json",
  "title": "Tempo Engine Suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "name", "chain", "tests"],
  "properties": {
    "format": { "const": "tempo-engine-suite/v1" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "origin": { "$ref": "#/$defs/origin" },
    "chain": { "$ref": "#/$defs/chain" },
    "metadata": { "$ref": "#/$defs/stringMap" },
    "defaults": { "$ref": "#/$defs/defaults" },
    "pre_run": {
      "type": "array",
      "items": { "$ref": "#/$defs/call" }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/test" }
    }
  },
  "$defs": {
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string" },
        "repository": { "type": "string" },
        "revision": { "type": "string" },
        "generator": { "type": "string" },
        "version": { "type": "string" },
        "seed": { "type": "string" }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["genesis"],
      "properties": {
        "name": { "type": "string" },
        "chain_id": { "type": "integer", "minimum": 0 },
        "hardfork": { "type": "string" },
        "genesis": { "type": "string", "minLength": 1 }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wait_for_persistence": { "type": "boolean" },
        "wait_for_caches": { "type": "boolean" },
        "expected_status": { "type": "string" }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "test"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "metadata": { "$ref": "#/$defs/stringMap" },
        "setup": {
          "type": "array",
          "items": { "$ref": "#/$defs/call" }
        },
        "test": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/call" }
        },
        "cleanup": {
          "type": "array",
          "items": { "$ref": "#/$defs/call" }
        }
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["method"],
          "not": { "anyOf": [{ "required": ["rlp"] }, { "required": ["rlp_file"] }] }
        },
        {
          "required": ["rlp"],
          "not": { "anyOf": [{ "required": ["rlp_file"] }, { "required": ["params"] }] }
        },
        {
          "required": ["rlp_file"],
          "not": { "anyOf": [{ "required": ["rlp"] }, { "required": ["params"] }] }
        }
      ],
      "allOf": [
        { "not": { "required": ["bal", "bal_file"] } },
        {
          "if": { "anyOf": [{ "required": ["bal"] }, { "required": ["bal_file"] }] },
          "then": { "anyOf": [{ "required": ["rlp"] }, { "required": ["rlp_file"] }] }
        },
        {
          "if": {
            "anyOf": [
              { "required": ["wait_for_persistence"] },
              { "required": ["wait_for_caches"] }
            ]
          },
          "then": { "anyOf": [{ "required": ["rlp"] }, { "required": ["rlp_file"] }] }
        }
      ],
      "properties": {
        "method": { "type": "string" },
        "params": { "type": "array" },
        "rlp": { "type": "string" },
        "rlp_file": { "type": "string" },
        "bal": { "type": "string" },
        "bal_file": { "type": "string" },
        "wait_for_persistence": { "type": "boolean" },
        "wait_for_caches": { "type": "boolean" },
        "block_number": { "type": "integer", "minimum": 0 },
        "block_hash": { "type": "string" },
        "gas_used": { "type": "integer", "minimum": 0 },
        "transaction_count": { "type": "integer", "minimum": 0 },
        "expected_status": { "type": "string" },
        "validation_error_contains": { "type": "string" },
        "expected_rpc_error_code": { "type": "integer" }
      }
    }
  }
}
